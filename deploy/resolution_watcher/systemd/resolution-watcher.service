[Unit]
Description=pm-edge resolution watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pmedge
Group=pmedge
WorkingDirectory=/opt/pm-edge
EnvironmentFile=/opt/pm-edge/.env
ExecStart=/opt/pm-edge/.venv/bin/python -m data.resolution_watcher.runner
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=900
NoNewPrivileges=true
MemoryHigh=250M
MemoryMax=400M
MemoryAccounting=yes

[Install]
WantedBy=multi-user.target
