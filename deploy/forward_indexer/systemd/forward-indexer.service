[Unit]
Description=pm-edge forward market data indexer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pmedge
Group=pmedge
WorkingDirectory=/opt/pm-edge
EnvironmentFile=/opt/pm-edge/.env
ExecStart=/opt/pm-edge/.venv/bin/python -m scripts.forward_index --output-dir /opt/pm-edge/data/raw/forward_index
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
# Memory caps so a discovery/capture spike degrades gracefully (MemoryHigh
# reclaims) and is contained (MemoryMax) instead of OOM-killing the box. Numbers
# leave headroom on the 4GB box above the watcher (MemoryMax=600M) + OS.
# the indexer's real steady-state/peak memory_mb before trusting these — see
# docs/EXPERIMENT_2_DEPLOY_RUNBOOK.md GATE 0.
MemoryHigh=1500M
MemoryMax=1800M
MemoryAccounting=yes
# App-level memory ceiling (distinct from the cgroup caps above): the emit loop
# flushes and the hi-cad near-resolution loop auto-sheds when process RSS exceeds
# this. Set here (after EnvironmentFile=, so it wins) rather than only in the
# hand-maintained .env, because it is load-bearing for Experiment 2 correctness:
# at the 1024M code default the hi-cad shed fires early under the raised two-axis
# baseline and under-captures. 1300M sits just under MemoryHigh=1500M. Versioned
# here so a redeploy cannot silently revert it. See EXPERIMENT_2_DEPLOY_RUNBOOK.md.
Environment=PM_EDGE_FORWARD_INDEXER_MAX_MEMORY_MB=1300
Environment=PM_EDGE_NEAR_RESOLUTION_CAPTURE_ENABLED=true
Environment=PM_EDGE_NEAR_RESOLUTION_MAX_MARKETS=30
Environment=PM_EDGE_NEAR_RESOLUTION_CADENCE_SECONDS=2

[Install]
WantedBy=multi-user.target
